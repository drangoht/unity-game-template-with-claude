# __GAME_NAME__ -- Git attributes
#
# The project is serialised in "Force Text" (EditorSettings.m_SerializationMode: 2):
# scenes, prefabs and assets are readable, diffable YAML. That is what makes the rules
# below useful -- in binary mode they would have no effect at all.

# ---------------------------------------------------------------- line endings
# LF everywhere, in the repo as in the working copy. Unity files MUST stay in LF:
# the editor rewrites them in LF at every save, and a CRLF checkout would turn every
# save into a whole-file diff.
#
# "eol=lf" is indispensable here: without it, Git follows "core.eol", which is
# "native" -- hence CRLF on Windows. Declaring it in .gitattributes rather than in
# the local config guarantees the same behaviour on every machine that clones.
* text=auto eol=lf

*.cs        text diff=csharp eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.asmdef    text eol=lf
*.txt       text eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

*.unity              text eol=lf merge=unityyamlmerge
*.prefab             text eol=lf merge=unityyamlmerge
*.asset              text eol=lf merge=unityyamlmerge
*.meta               text eol=lf merge=unityyamlmerge
*.mat                text eol=lf merge=unityyamlmerge
*.physicsMaterial2D  text eol=lf merge=unityyamlmerge
*.physicMaterial     text eol=lf merge=unityyamlmerge
*.controller         text eol=lf merge=unityyamlmerge
*.anim               text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.playable           text eol=lf merge=unityyamlmerge
*.mask               text eol=lf merge=unityyamlmerge
*.lighting           text eol=lf merge=unityyamlmerge
*.terrainlayer       text eol=lf merge=unityyamlmerge

# The "unityyamlmerge" driver merges Unity YAML by understanding its structure,
# where a line-by-line merge would produce a corrupted scene. It is enabled once
# per machine (path to be adapted to the editor version):
#
#   git config --global merge.unityyamlmerge.name "Unity SmartMerge"
#   git config --global merge.unityyamlmerge.driver \
#     '"<unity-folder>/<version>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %A %B %A'
#   git config --global merge.unityyamlmerge.recursive binary
#
# Without that configuration, Git simply falls back on the default merge:
# the attribute above is never blocking.

# ---------------------------------------------------------------- binaries
# Marked binary so that Git attempts neither normalisation nor a textual diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.pdb  binary
*.so   binary
*.dylib binary
*.a    binary
*.lib  binary
*.pdf  binary
*.zip  binary
*.7z   binary

# ---------------------------------------------------------------- Git LFS
# Today the repo only contains PNGs generated by code, all under 25 KB:
# moving them to LFS would cost more than it would return. The rules below
# anticipate the arrival of real assets -- graphic sources, models, audio, video --
# which do inflate the history irreversibly.
#
# They assume "git lfs install" has been done on the machine. See README.md.

*.psd  filter=lfs diff=lfs merge=lfs -text
*.psb  filter=lfs diff=lfs merge=lfs -text
*.ai   filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text

*.fbx   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text

*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text

*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Possible exemption: small placeholder audio files (Kenney, CC0) weigh 5 to 15 KB each.
# Routing them through LFS would force git-lfs on anyone who clones, for no gain -- and a
# project should clone and run without dependencies. Uncomment if needed:
# Assets/Audio/**/*.ogg -filter -diff -merge binary

# ---------------------------------------------------------------- linguist
# GitHub's language breakdown ignores whatever is not written by hand.
Assets/Art/**   linguist-generated
docs/**         linguist-documentation
