# ---------------------------------------------------------------- Unity
# Folders regenerated by the editor. Library/ in particular weighs several GB and is rebuilt
# entirely the first time the project is opened.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]rtifacts/

# Build stamp: written by BuildTools at every compilation, it describes the artefact and not the
# source. Versioning it would leave the repo modified after every build -- and the stamp would then
# carry a "+" suffix telling the player their version matches no commit.
/[Aa]ssets/[Rr]esources/build_sha.txt
/[Aa]ssets/[Rr]esources/build_sha.txt.meta

# Burst artefact dropped at the root by the WebGL build, outside any build folder.
/Data/

# Unity tool caches
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.consulo/

# Imported assets whose .meta Unity regenerates
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Tool paths specific to this machine (Unity, Python), resolved by tools/environment.ps1.
# Versioning them would send one workstation's path to all the others -- and the symptom, over
# there, would be "Unity.exe : The term 'Unity.exe' is not recognized as the name of a cmdlet".
tools/local.settings.json

# ---------------------------------------------------------------- C# / .NET
bin/
obj/
TestResults/
test-output.txt

# ---------------------------------------------------------------- IDE
.vs/
.vscode/
.idea/
*.csproj
!tests/*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.DotSettings.user

# ---------------------------------------------------------------- System
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- Misc
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
tools/__pycache__/
*.log

# ---------------------------------------------------------------- Warning
# NEVER ignore the .meta files: Unity stores the GUID of every asset in them. A missing .meta
# loses every reference that pointed at the asset (scripts detached from their GameObjects,
# emptied sprites). There is no *.meta rule here, and that is deliberate.
