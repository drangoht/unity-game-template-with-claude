# ---------------------------------------------------------------- Unity
# Dossiers régénérés par l'éditeur. Library/ notamment pèse plusieurs Go et se
# reconstruit intégralement à la première ouverture du projet.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]rtifacts/

# Tampon de build : écrit par BuildTools à chaque compilation, il décrit l'artefact et non la
# source. Le versionner rendrait le dépôt modifié après chaque build — et le tampon porterait
# alors un suffixe « + » qui dit au joueur que sa version ne correspond à aucun commit.
/[Aa]ssets/[Rr]esources/build_sha.txt
/[Aa]ssets/[Rr]esources/build_sha.txt.meta

# Artefact Burst déposé à la racine par le build WebGL, hors de tout dossier de build.
/Data/

# Caches d'outils Unity
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.consulo/

# Assets importés dont Unity régénère le .meta
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Chemins d'outils propres a cette machine (Unity, Python), resolus par tools/environnement.ps1.
# Les versionner enverrait le chemin d'un poste sur tous les autres -- et le symptome, la-bas,
# serait « Unity.exe : Le terme «Unity.exe» n'est pas reconnu comme nom d'applet de commande ».
tools/local.settings.json

# ---------------------------------------------------------------- C# / .NET
bin/
obj/
TestResults/
test-output.txt

# ---------------------------------------------------------------- IDE
.vs/
.vscode/
.idea/
*.csproj
!tests/*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.DotSettings.user

# ---------------------------------------------------------------- Système
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- Divers
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
tools/__pycache__/
*.log

# ---------------------------------------------------------------- Attention
# Ne JAMAIS ignorer les .meta : Unity y stocke le GUID de chaque asset. Un .meta manquant fait
# perdre toutes les références qui pointaient vers l'asset (scripts détachés de leurs
# GameObjects, sprites vidés). Aucune règle *.meta ici, et c'est délibéré.
