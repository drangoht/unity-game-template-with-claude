# The template itself does not compile: these rules mostly exist so that the content of skeleton/
# arrives intact in the generated projects.

# LF everywhere. A CRLF checkout would make every Unity file show up as modified from the editor's
# very first save, in ALL projects issued from the template.
* text=auto eol=lf

*.cs    text diff=csharp eol=lf
*.md    text eol=lf
*.ps1   text eol=lf
*.py    text eol=lf
*.asset text eol=lf
*.meta  text eol=lf

*.png binary
*.jpg binary
*.ttf binary
*.dll binary
